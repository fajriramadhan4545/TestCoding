{
  "info": {
    "name": "Ship Maintenance API (UUID)",
    "description": "Collection untuk testing RESTful API manajemen kapal dan log perawatan (maintenance) menggunakan Laravel 11 dengan Primary Keys UUID.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "1. Ships (Kapal)",
      "item": [
        {
          "name": "Get Ships (Daftar Kapal)",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json",
                "type": "text"
              }
            ],
            "url": {
              "raw": "{{base_url}}/ships?min_biaya=10000000&max_biaya=9000000000&status=completed&search=Nusantara&per_page=15",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "ships"
              ],
              "query": [
                {
                  "key": "min_biaya",
                  "value": "10000000",
                  "description": "Filter total biaya minimal (sample: 10 juta)"
                },
                {
                  "key": "max_biaya",
                  "value": "9000000000",
                  "description": "Filter total biaya maksimal (sample: 9 miilar)"
                },
                {
                  "key": "status",
                  "value": "completed",
                  "description": "Filter kapal berdasarkan status log servis terakhir: planned, ongoing, completed"
                },
                {
                  "key": "search",
                  "value": "Nusantara",
                  "description": "Cari berdasarkan nama kapal atau kode kapal"
                },
                {
                  "key": "per_page",
                  "value": "15",
                  "description": "Limit per page"
                }
              ]
            }
          },
          "response": []
        },
        {
          "name": "Get Ship Detail (Detail Kapal)",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json",
                "type": "text"
              }
            ],
            "url": {
              "raw": "{{base_url}}/ships/{{ship_uuid}}",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "ships",
                "{{ship_uuid}}"
              ]
            },
            "description": "Ganti {{ship_uuid}} dengan string UUID kapal yang sebenarnya (dapat disalin dari respons Get Ships)."
          },
          "response": []
        }
      ]
    },
    {
      "name": "2. Maintenance Logs (Log Servis)",
      "item": [
        {
          "name": "Get Maintenance Logs (Daftar Log Servis)",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json",
                "type": "text"
              }
            ],
            "url": {
              "raw": "{{base_url}}/maintenance-logs?ship_id={{ship_uuid}}&status=planned&date_from=2024-01-01&date_to=2026-12-31&per_page=15",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "maintenance-logs"
              ],
              "query": [
                {
                  "key": "ship_id",
                  "value": "{{ship_uuid}}",
                  "description": "Filter berdasarkan UUID Kapal"
                },
                {
                  "key": "status",
                  "value": "planned",
                  "description": "Filter berdasarkan status: planned, ongoing, completed"
                },
                {
                  "key": "date_from",
                  "value": "2024-01-01",
                  "description": "Batas tanggal mulai (YYYY-MM-DD)"
                },
                {
                  "key": "date_to",
                  "value": "2026-12-31",
                  "description": "Batas tanggal akhir (YYYY-MM-DD)"
                },
                {
                  "key": "per_page",
                  "value": "15",
                  "description": "Limit per page"
                }
              ]
            }
          },
          "response": []
        },
        {
          "name": "Get Maintenance Log Detail (Detail Log)",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json",
                "type": "text"
              }
            ],
            "url": {
              "raw": "{{base_url}}/maintenance-logs/{{log_uuid}}",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "maintenance-logs",
                "{{log_uuid}}"
              ]
            },
            "description": "Ganti {{log_uuid}} dengan string UUID log yang sebenarnya."
          },
          "response": []
        },
        {
          "name": "Complete Maintenance (Tandai Selesai & Auto-Schedule)",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Accept",
                "value": "application/json",
                "type": "text"
              }
            ],
            "url": {
              "raw": "{{base_url}}/maintenance-logs/{{log_uuid}}/complete",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "maintenance-logs",
                "{{log_uuid}}",
                "complete"
              ]
            },
            "description": "Ganti {{log_uuid}} dengan UUID log yang berstatus selain 'completed' untuk diubah menjadi 'completed' dan menjadwalkan otomatis servis berikutnya."
          },
          "response": []
        }
      ]
    }
  ],
  "variable": [
    {
      "key": "base_url",
      "value": "http://localhost:8000/api",
      "type": "string"
    },
    {
      "key": "ship_uuid",
      "value": "019ead17-c80b-7217-89a9-5a18d3b3bd8b",
      "type": "string"
    },
    {
      "key": "log_uuid",
      "value": "019ead17-c82a-7335-8bfb-8eb86f20aa3e",
      "type": "string"
    }
  ]
}
